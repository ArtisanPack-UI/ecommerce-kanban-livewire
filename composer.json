{
  "name": "artisanpack-ui/ecommerce-kanban-livewire",
  "description": "Livewire order kanban board for the ArtisanPack UI ecommerce engine.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "livewire",
    "ecommerce",
    "kanban",
    "orders",
    "fulfillment",
    "artisanpack-ui"
  ],
  "autoload": {
    "psr-4": {
      "ArtisanPackUI\\EcommerceKanbanLivewire\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jacob Martella",
      "email": "me@jacobmartella.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0|^13.0",
    "livewire/livewire": "^3.6|^4.0",
    "artisanpack-ui/ecommerce": "^1.2",
    "artisanpack-ui/livewire-ui-components": "^2.1",
    "artisanpack-ui/core": "^1.0",
    "artisanpack-ui/hooks": "^1.2"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "pestphp/pest-plugin-livewire": "^4.0",
    "pestphp/pest-plugin-browser": "^4.0",
    "artisanpack-ui/code-style": "^1.1",
    "artisanpack-ui/code-style-pint": "^1.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "laravel/pint": "^1.26",
    "orchestra/testbench": "^10.2|^11.0",
    "friendsofphp/php-cs-fixer": "^3.75"
  },
  "suggest": {
    "laravel/reverb": "Real-time board sync across browsers through Laravel Echo (any Laravel broadcaster works).",
    "artisanpack-ui/ecommerce-admin-livewire": "Links the board from the admin's navigation and order screens, and opens full orders from a card.",
    "artisanpack-ui/cms-framework": "Adds the board to the cms-framework admin menu."
  },
  "scripts": {
    "lint": [
      "./vendor/bin/php-cs-fixer fix --dry-run --diff",
      "./vendor/bin/phpcs"
    ],
    "fix": "./vendor/bin/php-cs-fixer fix",
    "cs": "./vendor/bin/phpcs",
    "cs:fix": "./vendor/bin/phpcbf",
    "test": "./vendor/bin/pest --testsuite=Unit,Feature",
    "test:browser": [
      "npm run build:browser",
      "./vendor/bin/pest --group=browser"
    ]
  },
  "config": {
    "sort-packages": false,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ArtisanPackUI\\EcommerceKanbanLivewire\\EcommerceKanbanLivewireServiceProvider"
      ]
    }
  }
}
